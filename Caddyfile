# =============================================================================
# halbimetal-platform 정적 서빙 설정
# 이 파일을 halbimetal-platform 저장소 최상위에 넣으세요.
#
# HTTPS 는 Cloudflare Tunnel 이 처리하므로 여기서는 평문 80 만 씁니다.
# (Coolify 의 Traefik → 이 컨테이너 80번으로 들어옵니다)
#
# 핵심 설계 — admin/hub 우회 차단
#   Cloudflare Access 로 /admin 과 /hub 를 잠글 예정인데,
#   누군가 /admin.html 로 직접 들어오면 Access 를 건너뛰게 됩니다.
#   그래서 .html 직접 접근은 클린 URL 로 301 넘겨서 입구를 하나로 만듭니다.
#     /admin.html  →  /admin   (Access 가 지키는 경로)
#     /hub.html    →  /hub
# =============================================================================

:80 {
	encode zstd gzip

	# ---- 보안 헤더 ----
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# ---- 헬스체크 (Coolify·Docker 가 확인) ----
	handle /healthz {
		respond "ok" 200
	}

	# ---- .html 직접 접근 차단: 클린 URL 로 넘김 ----
	# handle 블록은 위에서부터 하나만 실행되므로 무한 리다이렉트가 생기지 않습니다.
	# ⚠️ redir 의 첫 인자가 '/' 로 시작하면 Caddy 는 그것을 '목적지'가 아니라
	#    '경로 매처'로 읽습니다. 반드시 `redir * <목적지>` 형태로 써야 합니다.
	#    (`redir /admin permanent` 로 쓰면 리다이렉트가 조용히 무시됩니다)
	handle /admin.html {
		redir * /admin permanent
	}
	handle /hub.html {
		redir * /hub permanent
	}

	# ---- 나머지 전부 ----
	handle {
		root * /srv

		# Vite 가 파일명에 해시를 붙이므로 자산은 오래 캐시해도 안전합니다
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# HTML 과 뉴스 데이터는 캐시하지 않음 — 배포·뉴스 갱신이 바로 보이도록
		# (header 는 try_files 내부 재작성 전의 경로로 판단하므로
		#  /admin, /hub 같은 클린 URL 도 함께 적어줘야 합니다)
		@nocache path / /admin /hub *.html /data/*
		header @nocache Cache-Control "no-cache, must-revalidate"

		# /admin → /admin.html,  /hub → /hub.html 로 내부 연결
		try_files {path} {path}.html {path}/index.html

		file_server
	}
}
